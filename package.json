{
  "name": "vscode-restore-terminals",
  "displayName": "Restore Terminals (Continued)",
  "description": "Restore your terminal layout automatically. Open split integrated terminals with custom names, icons, colors, working directories and env vars, and run startup commands every time you open a workspace.",
  "version": "1.2.7",
  "publisher": "KasperiP",
  "license": "MIT",
  "icon": "icon.png",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KasperiP/vscode-restore-terminals"
  },
  "homepage": "https://github.com/KasperiP/vscode-restore-terminals#readme",
  "bugs": {
    "url": "https://github.com/KasperiP/vscode-restore-terminals/issues"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=26"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "terminals",
    "restore terminals",
    "terminal layout",
    "split terminal",
    "integrated terminal",
    "startup",
    "startup commands",
    "run commands",
    "auto run",
    "automation",
    "workspace",
    "multi-root",
    "session",
    "tasks",
    "shell",
    "dev server",
    "productivity",
    "terminal profiles",
    "terminal manager"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": "marketplace",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "restore-terminals.restoreTerminals",
        "title": "Restore Terminals"
      }
    ],
    "configuration": {
      "title": "Restore Terminals",
      "type": "object",
      "properties": {
        "restoreTerminals.runOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Whether or not to restore the terminals when VSCode starts up."
        },
        "restoreTerminals.keepExistingTerminalsOpen": {
          "type": "boolean",
          "default": false,
          "description": "Whether or not to keep any currently open terminals open when restoring."
        },
        "restoreTerminals.artificialDelayMilliseconds": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Leave this null (the default) and Restore Terminals waits for each shell to actually start before running its commands, which is both faster and more reliable than a fixed delay. Set a number of milliseconds only if your setup still glitches out or runs commands in the wrong window; it adds that pause between every step, like older versions did."
        },
        "restoreTerminals.terminals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwd": {
                "type": "string",
                "description": "The working directory for this terminal window and its splits. Supports ${workspaceFolder} in a single-root workspace and ${workspaceFolder:folderName} in a multi-root workspace."
              },
              "location": {
                "type": "string",
                "enum": [
                  "panel",
                  "editor"
                ],
                "description": "Where this terminal window opens: \"panel\" for the terminal panel, or \"editor\" to open it as an editor tab. Its splits follow it either way. Leave it unset to use the terminal.integrated.defaultLocation setting."
              },
              "splitTerminals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The name to give the terminal window"
                    },
                    "icon": {
                      "type": "string",
                      "description": "The id of a VSCode product icon to give the terminal, for example \"terminal-bash\" or \"flame\". See https://code.visualstudio.com/api/references/icons-in-labels for the full list.",
                      "examples": [
                        "terminal",
                        "terminal-bash",
                        "server-process",
                        "browser",
                        "beaker",
                        "database",
                        "tools",
                        "rocket",
                        "flame"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "description": "The id of a VSCode theme colour for the terminal icon, for example \"terminal.ansiGreen\". The terminal.ansi* keys are recommended as they stay readable in every theme.",
                      "examples": [
                        "terminal.ansiRed",
                        "terminal.ansiGreen",
                        "terminal.ansiYellow",
                        "terminal.ansiBlue",
                        "terminal.ansiMagenta",
                        "terminal.ansiCyan",
                        "terminal.ansiWhite",
                        "terminal.ansiBrightRed",
                        "terminal.ansiBrightGreen",
                        "terminal.ansiBrightYellow",
                        "terminal.ansiBrightBlue",
                        "terminal.ansiBrightMagenta",
                        "terminal.ansiBrightCyan",
                        "terminal.ansiBrightBlack"
                      ]
                    },
                    "cwd": {
                      "type": "string",
                      "description": "The working directory for this split only, overriding the terminal window's cwd. Supports the same ${workspaceFolder} variables."
                    },
                    "shellPath": {
                      "type": "string",
                      "description": "Path to a specific shell executable to run this split under, instead of the default terminal shell."
                    },
                    "shellArgs": {
                      "type": [
                        "array",
                        "string"
                      ],
                      "description": "Arguments to pass to the shell executable.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "type": "object",
                      "description": "Environment variables for this split, added to the ones it would normally inherit. Set a value to null to remove that variable.",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "commands": {
                      "type": "array",
                      "description": "The shell commands to execute when this terminal opens.",
                      "items": {
                        "type": "string",
                        "description": "A shell command to run."
                      }
                    },
                    "shouldRunCommands": {
                      "type": "boolean",
                      "description": "Whether to actually run the commands in the terminal, or just paste them there."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "restore-terminals.json",
        "url": "./schemas/restore-terminals.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.js --production",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test \"src/test/unit/*.test.ts\"",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:unit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
